# Plantilla de variables de entorno para PAXAPOS COMERCIO
# Copia este archivo como .env y completa con tus credenciales reales de Firebase y Google Cloud

VITE_GOOGLE_CLIENT_ID=TU_GOOGLE_CLIENT_ID.apps.googleusercontent.com
VITE_FIREBASE_API_KEY=TU_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto-firebase.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto-firebase
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto-firebase.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=TU_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=1:TU_MESSAGING_SENDER_ID:web:TU_APP_ID
