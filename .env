# Configuración de Firebase y Google OAuth
# Reemplaza estos valores con las credenciales reales de tu proyecto en Firebase Console y Google Cloud Console

VITE_GOOGLE_CLIENT_ID=TU_GOOGLE_CLIENT_ID_REAL.apps.googleusercontent.com
VITE_FIREBASE_API_KEY=TU_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=paxapos-stellar-wallet.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=paxapos-stellar-wallet
VITE_FIREBASE_STORAGE_BUCKET=paxapos-stellar-wallet.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=TU_FIREBASE_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=TU_FIREBASE_APP_ID
